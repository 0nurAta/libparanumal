void surfaceTerms(const int e,
                  const int sk,
                  const int face,
                  const int i,
                  const int j,
                  const dfloat *x,
                  const dfloat *y,
                  const dfloat *sgeo,
                  const int *vmapM,
                  const int *EToB,
                  const dfloat *q,
                  const dfloat c,
                  dfloat s_vFx[p_Nq][p_Nq],
                  dfloat s_vFy[p_Nq][p_Nq],
                  dfloat s_pFx[p_Nq][p_Nq],
                  dfloat s_pFy[p_Nq][p_Nq]){
  
  const int bc     = EToB[face+p_Nfaces*e];
  const dfloat nx  = sgeo[sk*p_Nsgeo+p_NXID];
  const dfloat ny  = sgeo[sk*p_Nsgeo+p_NYID];
  const dfloat wSJ = sgeo[sk*p_Nsgeo+p_WSJID];

  const dlong id = vmapM[sk];
  const int vid  = id%p_Np;
  const dlong qbase = e*p_Np*p_Nfields + vid;

  dfloat q1 = q[qbase + 0*p_Np]; // rho
  dfloat q2 = q[qbase + 1*p_Np]; // rho*u/c
  dfloat q3 = q[qbase + 2*p_Np]; // rho*v/c
  dfloat q4 = q[qbase + 3*p_Np];
  dfloat q5 = q[qbase + 4*p_Np];
  dfloat q6 = q[qbase + 5*p_Np];

  dfloat p    = q1*c*c;

  dfloat T12 = -c*c*(          q4-q2*q3/q1); 
  dfloat T11 = -c*c*(sqrt(2.0)*q5-q2*q2/q1); 
  dfloat T22 = -c*c*(sqrt(2.0)*q6-q3*q3/q1); 
 
  s_vFx[j][i] += (bc==1) ? -wSJ*(nx*T11 + ny*T12): 0.0; 
  s_vFy[j][i] += (bc==1) ? -wSJ*(nx*T12 + ny*T22): 0.0; 
  s_pFx[j][i] += (bc==1) ?  wSJ*p*nx: 0.0; 
  s_pFy[j][i] += (bc==1) ?  wSJ*p*ny: 0.0; 
}


@kernel void bnsForcesSurfaceQuad2D(const dlong Nelements,
                                    const dfloat c,
                                    @restrict const  dfloat *  sgeo,
                                    @restrict const  dfloat *  SM,
                                    @restrict const  dlong  *  vmapM,
                                    @restrict const  int    *  EToB,
                                    @restrict const  dfloat *  x,
                                    @restrict const  dfloat *  y,
                                    @restrict const  dfloat *  z,
                                    @restrict const  dfloat *  q,
                                    @restrict        dfloat *  F){

for(dlong e=0;e<Nelements;++e;@outer(0)){
  
    // not sure if we enforce single boundary face per element!
    @shared dfloat s_vFx[p_Nq][p_Nq];
    @shared dfloat s_vFy[p_Nq][p_Nq];
    @shared dfloat s_pFx[p_Nq][p_Nq];
    @shared dfloat s_pFy[p_Nq][p_Nq];


    for(int i=0;i<p_Nq;++i;@inner(0)){
        #pragma unroll p_Nq
          for(int j=0;j<p_Nq;++j){
            s_vFx[j][i] = 0.;
            s_vFy[j][i] = 0.;
            s_pFx[j][i] = 0.;
            s_pFy[j][i] = 0.;
          }
      }

    // face 0 & 2
      for(int i=0;i<p_Nq;++i;@inner(0)){
          const dlong sk0 = e*p_Nfp*p_Nfaces + 0*p_Nfp + i;
          const dlong sk2 = e*p_Nfp*p_Nfaces + 2*p_Nfp + i;

          surfaceTerms(e, sk0, 0, i, 0, 
                       x, y, sgeo, vmapM, EToB, q,c,
                       s_vFx, s_vFy, s_pFx, s_pFy);

          surfaceTerms(e, sk2, 2, i, p_Nq-1, 
                       x, y, sgeo, vmapM, EToB, q,c,
                       s_vFx, s_vFy, s_pFx, s_pFy);
      }

    // face 1 & 3
      for(int j=0;j<p_Nq;++j;@inner(0)){
          const dlong sk1 = e*p_Nfp*p_Nfaces + 1*p_Nfp + j;
          const dlong sk3 = e*p_Nfp*p_Nfaces + 3*p_Nfp + j;

          //surfaceTerms(sk1,1,p_Nq-1,j);
          surfaceTerms(e, sk1, 1, p_Nq-1, j,
                       x, y, sgeo, vmapM, EToB, q,c,
                       s_vFx, s_vFy, s_pFx, s_pFy);

          surfaceTerms(e, sk3, 3, 0, j, 
                       x, y, sgeo, vmapM, EToB, q,c,
                       s_vFx, s_vFy, s_pFx, s_pFy);
      }


     for(int i=0;i<p_Nq;++i;@inner(0)){
          #pragma unroll p_Nq
          for(int j=0;j<p_Nq;++j){
           const dlong shift = Nelements*p_Np;
           const dlong base  = e*p_Np + j*p_Nq + i; 
          F[base+0*shift] = s_vFx[j][i];
          F[base+1*shift] = s_vFy[j][i];
          F[base+2*shift] = s_pFx[j][i];
          F[base+3*shift] = s_pFy[j][i];
        }
      }
    }
  }