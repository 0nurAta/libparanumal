@kernel void AssignConformSimpleTri2D(
    const dlong Nelements,
    const dlong Nnodes,
    @restrict const long long *elemList,
    @restrict const dlong *activeFlag,
    @restrict const dlong *confFace,
    @restrict const dlong *splitFace,
    @restrict const long long *hangVertex,

    @restrict long long *elemListCompact,
    @restrict dlong *confFaceCompact,
    @restrict dlong *splitFaceCompact,
    @restrict long long *hangVertexCompact,

    @restrict long long *new_v_id,
    @restrict dlong *NrefineOut,
    @restrict dlong *new_vertex) {

  for(dlong dummy=0; dummy<1; ++dummy; @outer(0)) {
    for(int t=0; t<1; ++t; @inner(0)) {

      dlong counter = 0;

      // Compact sparse candidate output.
      for(dlong e=0; e<Nelements; ++e) {
        if(activeFlag[e] == 1 &&
           elemList[3*e+0] >= 0) {

          elemListCompact[3*counter+0] =
            elemList[3*e+0];

          elemListCompact[3*counter+1] =
            elemList[3*e+1];

          elemListCompact[3*counter+2] =
            elemList[3*e+2];

          confFaceCompact[counter] =
            confFace[e];

          splitFaceCompact[counter] =
            splitFace[e];

          hangVertexCompact[counter] =
            hangVertex[e];

          counter++;
        }
      }

      // Remove duplicate requests for the same target element.
      // Prefer a request whose conforming face is its split face.
      for(dlong i=0; i<counter; ++i) {

        if(elemListCompact[3*i+0] < 0) {
          continue;
        }

        for(dlong j=i+1; j<counter; ++j) {

          if(elemListCompact[3*j+0] < 0) {
            continue;
          }

          const bool sameElement =
            elemListCompact[3*i+0] ==
            elemListCompact[3*j+0];

          if(sameElement) {

            const bool iMatches =
              confFaceCompact[i] ==
              splitFaceCompact[i];

            const bool jMatches =
              confFaceCompact[j] ==
              splitFaceCompact[j];

            if(!iMatches && jMatches) {

              elemListCompact[3*i+0] =
                elemListCompact[3*j+0];

              elemListCompact[3*i+1] =
                elemListCompact[3*j+1];

              elemListCompact[3*i+2] =
                elemListCompact[3*j+2];

              confFaceCompact[i] =
                confFaceCompact[j];

              splitFaceCompact[i] =
                splitFaceCompact[j];

              hangVertexCompact[i] =
                hangVertexCompact[j];
            }

            elemListCompact[3*j+0] = -1;
            elemListCompact[3*j+1] = -1;
            elemListCompact[3*j+2] = -1;
          }
        }
      }

      // Compact again after duplicate removal.
      dlong compactCounter = 0;

      for(dlong i=0; i<counter; ++i) {

        if(elemListCompact[3*i+0] >= 0) {

          if(compactCounter != i) {

            elemListCompact[3*compactCounter+0] =
              elemListCompact[3*i+0];

            elemListCompact[3*compactCounter+1] =
              elemListCompact[3*i+1];

            elemListCompact[3*compactCounter+2] =
              elemListCompact[3*i+2];

            confFaceCompact[compactCounter] =
              confFaceCompact[i];

            splitFaceCompact[compactCounter] =
              splitFaceCompact[i];

            hangVertexCompact[compactCounter] =
              hangVertexCompact[i];
          }

          compactCounter++;
        }
      }

      counter = compactCounter;

      // Bubble sort by edge (vid0, vid1).
      for(dlong i=0; i<counter-1; ++i) {

        bool swapped = false;

        for(dlong j=0; j<counter-i-1; ++j) {

          const long long v0A =
            elemListCompact[3*j+1];

          const long long v1A =
            elemListCompact[3*j+2];

          const long long v0B =
            elemListCompact[3*(j+1)+1];

          const long long v1B =
            elemListCompact[3*(j+1)+2];

          const bool shouldSwap =
            (v0A > v0B) ||
            (v0A == v0B && v1A > v1B);

          if(shouldSwap) {

            for(int n=0; n<3; ++n) {
              const long long tmp =
                elemListCompact[3*j+n];

              elemListCompact[3*j+n] =
                elemListCompact[3*(j+1)+n];

              elemListCompact[3*(j+1)+n] = tmp;
            }

            const dlong confTmp =
              confFaceCompact[j];

            confFaceCompact[j] =
              confFaceCompact[j+1];

            confFaceCompact[j+1] = confTmp;

            const dlong splitTmp =
              splitFaceCompact[j];

            splitFaceCompact[j] =
              splitFaceCompact[j+1];

            splitFaceCompact[j+1] = splitTmp;

            const long long hangTmp =
              hangVertexCompact[j];

            hangVertexCompact[j] =
              hangVertexCompact[j+1];

            hangVertexCompact[j+1] = hangTmp;

            swapped = true;
          }
        }

        if(!swapped) {
          break;
        }
      }

      // Assign vertex IDs.
      dlong newCount = 0;

      for(dlong i=0; i<counter; ++i) {

        new_v_id[2*i+0] =
          elemListCompact[3*i+0];

        const bool sameEdge =
          i > 0 &&
          elemListCompact[3*i+1] ==
            elemListCompact[3*(i-1)+1] &&
          elemListCompact[3*i+2] ==
            elemListCompact[3*(i-1)+2];

        if(sameEdge) {

          new_v_id[2*i+1] =
            new_v_id[2*(i-1)+1];

        } else if(confFaceCompact[i] ==
                  splitFaceCompact[i]) {

          // Reuse the existing hanging vertex.
          new_v_id[2*i+1] =
            hangVertexCompact[i];

        } else {

          // This split creates a new midpoint.
          new_v_id[2*i+1] =
            Nnodes + (long long)newCount;

          newCount++;
        }
      }

      NrefineOut[0] = counter;
      new_vertex[0] = newCount;
    }
  }
}
