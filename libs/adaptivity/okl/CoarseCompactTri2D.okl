@kernel void CoarseCompactTri2D(
    const dlong NelementsOld,
    const dlong hierarchyStride,
    @restrict const dlong *perm,

    @restrict const dfloat *Q,
    @restrict const dfloat *Qold,
    @restrict const dfloat *EX,
    @restrict const dfloat *EY,
    @restrict const long long int *EToV,
    @restrict const int *EToB,
    @restrict const dlong *RefFlag,
    @restrict const dlong *EToRefLevel,
    @restrict const dlong *PToC,
    @restrict const dlong *IntFlag,

    @restrict dfloat *QCompact,
    @restrict dfloat *EXCompact,
    @restrict dfloat *EYCompact,
    @restrict long long int *EToVCompact,
    @restrict int *EToBCompact,
    @restrict dlong *RefFlagCompact,
    @restrict dlong *EToRefLevelCompact,
    @restrict dlong *PToCCompact,
    @restrict dlong *IntFlagCompact) {

  for(dlong e=0; e<NelementsOld; ++e; @outer(0)) {
    for(int n=0; n<p_Np; ++n; @inner(0)) {
      const dlong newElement = perm[e];

      if(newElement >= 0) {
        QCompact[newElement*p_Np+n] = Q[e*p_Np+n];

        if(n < 3) {
          const dlong oldVertexId = 3*e+n;
          const dlong newVertexId = 3*newElement+n;

          EXCompact[newVertexId] = EX[oldVertexId];
          EYCompact[newVertexId] = EY[oldVertexId];
          EToVCompact[newVertexId] = EToV[oldVertexId];
          EToBCompact[newVertexId] = EToB[oldVertexId];
        }

        if(n == 0) {
          RefFlagCompact[newElement] = RefFlag[e];
          EToRefLevelCompact[newElement] = EToRefLevel[e];

          for(dlong level=0; level<hierarchyStride; ++level) {
            const dlong oldId = e*hierarchyStride+level;
            const dlong newId = newElement*hierarchyStride+level;
            const dlong oldElementId = PToC[oldId];

            if(oldElementId >= 0 && oldElementId < NelementsOld) {
              PToCCompact[newId] = perm[oldElementId];
            } else {
              PToCCompact[newId] = -1;
            }

            IntFlagCompact[newId] = IntFlag[oldId];
          }
        }
      }
    }
  }
}
