@kernel void ConformCandidateTri2D(
    const dlong Nelements,
    const dlong level,
    @restrict dlong *RefFlag,
    @restrict dlong *ConfFlag,
    @restrict dlong *FaceFlag,
    @restrict const dlong *EToRefLevel,
    @restrict const dlong *PCS,
    @restrict const dlong *PToC,
    @restrict const int *EToF,
    @restrict const int *EToB,
    @restrict const dfloat *EX,
    @restrict const dfloat *EY,
    @restrict const long long int *EToV,
    @restrict long long int *elemList,
    @restrict dlong *confFace,
    @restrict dlong *splitFace,
    @restrict long long int *hangVertex,
    @restrict dlong *activeFlag) {

  for(dlong e=0; e<Nelements; ++e; @outer(0)) {
    for(int t=0; t<1; ++t; @inner(0)) {

      const dlong id = 3*e;
      const dfloat tol = (dfloat)1.0e-10;

      dlong e_c = -1;
      dlong conformingFace = -1;
      dlong selectedFace = -1;
      long long int hangingNode = -1;
      long long int vid0 = -1;
      long long int vid1 = -1;

      activeFlag[e] = 0;
      confFace[e] = -1;
      splitFace[e] = -1;
      hangVertex[e] = -1;

      elemList[3*e+0] = -1;
      elemList[3*e+1] = -1;
      elemList[3*e+2] = -1;

      if(ConfFlag[e] > -1 &&
         EToRefLevel[e] < level+3) {

        const dlong ef = ConfFlag[e];

        if(ef >= 0 && ef < Nelements) {

          const dlong sibling = PCS[3*ef+2];

          dlong secondChild = -1;
          const dlong efLevel = EToRefLevel[ef];

          if(efLevel > 0) {
            secondChild =
              PToC[ef*(level+3) + efLevel-1];
          }

          dlong targets[3];
          targets[0] = ef;
          targets[1] = sibling;
          targets[2] = secondChild;

          // Preserve CPU search order:
          // face 0/1/2, then parent/sibling/child.
          for(int f=0; f<3; ++f) {
            for(int c=0; c<3; ++c) {

              const dlong target = targets[c];

              if(e_c == -1 &&
                 target >= 0 &&
                 target < Nelements) {

                const dlong targetId = 3*target;
                const dlong faceId = targetId+f;

                if(EToF[faceId] == -1 &&
                   EToB[faceId] == -1) {

                  const int fa = f;
                  const int fb = (f+1)%3;

                  const dfloat midpointX =
                    (dfloat)0.5*
                    (EX[targetId+fa] + EX[targetId+fb]);

                  const dfloat midpointY =
                    (dfloat)0.5*
                    (EY[targetId+fa] + EY[targetId+fb]);

                  // Preserve CPU local-vertex order: 2, 0, 1.
                  for(int q=0; q<3; ++q) {
                    const int lv =
                      (q == 0) ? 2 : ((q == 1) ? 0 : 1);

                    if(e_c == -1 &&
                       fabs(EX[id+lv]-midpointX) < tol &&
                       fabs(EY[id+lv]-midpointY) < tol) {

                      e_c = target;
                      conformingFace = faceId;
                      hangingNode = EToV[id+lv];
                    }
                  }
                }
              }
            }
          }
        }

        if(e_c > -1) {

          const dlong idc = 3*e_c;
          int localFace = 0;

          if(EToRefLevel[e_c] < 1) {

            const dfloat dx0 = EX[idc+1]-EX[idc+0];
            const dfloat dy0 = EY[idc+1]-EY[idc+0];
            const dfloat dx1 = EX[idc+2]-EX[idc+1];
            const dfloat dy1 = EY[idc+2]-EY[idc+1];
            const dfloat dx2 = EX[idc+2]-EX[idc+0];
            const dfloat dy2 = EY[idc+2]-EY[idc+0];

            const dfloat mag0 = dx0*dx0 + dy0*dy0;
            const dfloat mag1 = dx1*dx1 + dy1*dy1;
            const dfloat mag2 = dx2*dx2 + dy2*dy2;

            if(mag0 >= mag1 && mag0 >= mag2) {
              localFace = 0;
            } else if(mag1 >= mag2) {
              localFace = 1;
            } else {
              localFace = 2;
            }
          }

          selectedFace = idc+localFace;

          const int va = localFace;
          const int vb = (localFace+1)%3;

          vid0 = EToV[idc+va];
          vid1 = EToV[idc+vb];

          if(vid0 > vid1) {
            const long long int tmp = vid0;
            vid0 = vid1;
            vid1 = tmp;
          }

          RefFlag[e_c] = 1;
          FaceFlag[selectedFace] = 1;

          elemList[3*e+0] = e_c;
          elemList[3*e+1] = vid0;
          elemList[3*e+2] = vid1;

          confFace[e] = conformingFace;
          splitFace[e] = selectedFace;
          hangVertex[e] = hangingNode;
          activeFlag[e] = 1;

          if(conformingFace == selectedFace) {
            ConfFlag[e] = -1;
          }

        } else {
          ConfFlag[e] = -1;
        }
      }
    }
  }
}