@kernel void AssignSimpleTri2D(const dlong Nelements,
                               const dlong Nnodes,
                               @restrict const long long int * elemList,
                               @restrict const dlong * activeFlag,
                               @restrict long long int * elemListCompact,
                               @restrict long long int * new_v_id,
                               @restrict dlong * NrefineOut,
                               @restrict dlong * new_vertex) {

  for(dlong dummy=0;dummy<1;++dummy;@outer(0)) {
    for(int t=0; t<1; ++t; @inner(0)) {
    dlong counter = 0;

    // Compact
    for(dlong e=0;e<Nelements;++e) {

      if(activeFlag[e] == 1 && elemList[e*3+0] != -1) {

        elemListCompact[counter*3+0] = elemList[e*3+0];
        elemListCompact[counter*3+1] = elemList[e*3+1];
        elemListCompact[counter*3+2] = elemList[e*3+2];
      
        counter++;
      }
    }

    // Simple bubble sort by (vid0, vid1)
    for(dlong i=0;i<counter-1;++i) {

      bool swp = false;

      for(dlong j=0;j<counter-i-1;++j) {

        const long long int elemA = elemListCompact[j*3+0];
        const long long int v0A   = elemListCompact[j*3+1];
        const long long int v1A   = elemListCompact[j*3+2];

        const long long int elemB = elemListCompact[(j+1)*3+0];
        const long long int v0B   = elemListCompact[(j+1)*3+1];
        const long long int v1B   = elemListCompact[(j+1)*3+2];
        const bool shouldSwap =
          (v0A > v0B) ||
          (v0A == v0B && v1A > v1B);

        if(shouldSwap) {

          elemListCompact[j*3+0] = elemB;
          elemListCompact[j*3+1] = v0B;
          elemListCompact[j*3+2] = v1B;
          
          elemListCompact[(j+1)*3+0] = elemA;
          elemListCompact[(j+1)*3+1] = v0A;
          elemListCompact[(j+1)*3+2] = v1A;
        
          swp = true;
        }
      }

      if(!swp) {
        break;
      }
    }
    
    // Assign new vertex ids, same as CPU NewestVertex2
    dlong k = 0;

    for(dlong i=0;i<counter;++i) {

      if(i > 0) {

        const bool sameEdge =
          elemListCompact[i*3+1] == elemListCompact[(i-1)*3+1] &&
          elemListCompact[i*3+2] == elemListCompact[(i-1)*3+2];

        if(!sameEdge) {
          k++;
          
        }
      }

      new_v_id[i*2+0] = elemListCompact[i*3+0];
      new_v_id[i*2+1] = Nnodes + k;
      

    }

    NrefineOut[0] = counter;
    new_vertex[0] = (counter > 0) ? (k + 1) : 0;
    
  }
  }
}
